# Discord Bot Token (Required)
TOKEN=your_bot_token_here

# Discord Application Client ID (Required for deploying slash commands)
CLIENT_ID=your_client_id_here

# Vote and Invite links (Used by /vote command)
VOTE_LINK=https://top.gg/bot/your_bot_id/vote
INVITE_LINK=https://discord.com/oauth2/authorize?client_id=your_client_id_here&permissions=3147776&scope=bot%20applications.commands
